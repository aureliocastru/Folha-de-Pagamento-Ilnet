# ==========================================================================
# Folha de Pagamento — variáveis de ambiente (copie para .env e preencha)
# NUNCA versione o arquivo .env. As credenciais do IXC são secretas.
# ==========================================================================

# --- Banco de dados (PostgreSQL) ---
# Em dev local (docker-compose) já vem preenchido. No EasyPanel use a
# connection string do serviço Postgres que você criar lá.
DATABASE_URL="postgresql://folha:folha@localhost:5432/folha?schema=public"

# --- API ---
API_PORT=3333
# Origens liberadas no CORS (frontend). Separe por vírgula.
CORS_ORIGINS="http://localhost:5173"
# Segredo do JWT de login da aplicação (troque por um valor aleatório longo)
JWT_SECRET="troque-por-uma-chave-aleatoria-bem-longa"
JWT_EXPIRES_IN="8h"

# --- Usuário administrador inicial (usado pelo seed: npm run db:seed) ---
ADMIN_EMAIL="admin@empresa.com"
ADMIN_SENHA="troque-esta-senha"

# --- Integração IXC ---
# Domínio do seu IXC, SEM https:// e SEM barra final. Ex: provedor.exemplo.com.br
IXC_HOST=""
# Token do IXC no formato id:hash  (ex.: 41:5a633da2ab7ee1d5fe60bfa00efcde40...)
# Gere/rotacione em: IXC > Configurações > Integrações > Tokens da API.
IXC_TOKEN=""
# Timeout das chamadas ao IXC em ms
IXC_TIMEOUT_MS=30000
# Intervalo (minutos) da verificação automática do retorno do banco (0 desliga)
SYNC_PAGAMENTOS_INTERVALO_MIN=10
# 1 = o app só LÊ o IXC: toda gravação é recusada antes de sair daqui. Para um
# ambiente de teste apontando para o IXC de produção. Em produção, deixe vazio.
IXC_SOMENTE_LEITURA=

# --- ModoBank (API da ONZ): pagar boleto e Pix direto daqui ---
# Vazios = o pagamento pelo ModoBank continua saindo pela tela do banco no IXC.
# A credencial é criada no portal do banco (Configurações > Credenciais > API
# CONTAS), com o IP do servidor liberado. Nunca escreva os valores aqui.
MODOBANK_CLIENT_ID=
MODOBANK_CLIENT_SECRET=
# O arquivo .pfx da credencial em base64. No PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("caminho\arquivo.pfx")) | Set-Clipboard
MODOBANK_CERTIFICADO=
MODOBANK_CERTIFICADO_SENHA=
# A "URL da API" que o portal mostra junto da credencial, terminando em /api/v2
MODOBANK_API_URL=https://secureapi.sulcredi1-prod.onz.software/api/v2
# APPROVAL_REQUIRED = o banco só paga depois de alguém aprovar lá; INSTANT = na hora
MODOBANK_FLUXO=APPROVAL_REQUIRED
# O recebimento (cash in): o .pfx do zip CASH_IN em base64, a senha dele e a URL
# que o portal mostra junto da credencial de recebimento. ID e segredo em branco
# = os mesmos de cima. Sem certificado e URL, o recebimento fica desligado.
MODOBANK_RECEBER_CLIENT_ID=
MODOBANK_RECEBER_CLIENT_SECRET=
MODOBANK_RECEBER_CERTIFICADO=
MODOBANK_RECEBER_CERTIFICADO_SENHA=
MODOBANK_RECEBER_API_URL=

# --- Frontend (apps/web) ---
# URL pública da API que o frontend vai consumir
VITE_API_URL="http://localhost:3333"
