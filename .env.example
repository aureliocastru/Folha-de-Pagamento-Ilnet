# ==========================================================================
# Folha de Pagamento — variáveis de ambiente (copie para .env e preencha)
# NUNCA versione o arquivo .env. As credenciais do IXC são secretas.
# ==========================================================================

# --- Banco de dados (PostgreSQL) ---
# Em dev local (docker-compose) já vem preenchido. No EasyPanel use a
# connection string do serviço Postgres que você criar lá.
DATABASE_URL="postgresql://folha:folha@localhost:5432/folha?schema=public"

# --- API ---
API_PORT=3333
# Origens liberadas no CORS (frontend). Separe por vírgula.
CORS_ORIGINS="http://localhost:5173"
# Segredo do JWT de login da aplicação (troque por um valor aleatório longo)
JWT_SECRET="troque-por-uma-chave-aleatoria-bem-longa"
JWT_EXPIRES_IN="8h"

# --- Usuário administrador inicial (usado pelo seed: npm run db:seed) ---
ADMIN_EMAIL="admin@empresa.com"
ADMIN_SENHA="troque-esta-senha"

# --- Integração IXC ---
# Domínio do seu IXC, SEM https:// e SEM barra final. Ex: provedor.exemplo.com.br
IXC_HOST=""
# Token do IXC no formato id:hash  (ex.: 41:5a633da2ab7ee1d5fe60bfa00efcde40...)
# Gere/rotacione em: IXC > Configurações > Integrações > Tokens da API.
IXC_TOKEN=""
# Timeout das chamadas ao IXC em ms
IXC_TIMEOUT_MS=30000
# Intervalo (minutos) da verificação automática do retorno do banco (0 desliga)
SYNC_PAGAMENTOS_INTERVALO_MIN=10
# 1 = o app só LÊ o IXC: toda gravação é recusada antes de sair daqui. Para um
# ambiente de teste apontando para o IXC de produção. Em produção, deixe vazio.
IXC_SOMENTE_LEITURA=

# --- Frontend (apps/web) ---
# URL pública da API que o frontend vai consumir
VITE_API_URL="http://localhost:3333"
