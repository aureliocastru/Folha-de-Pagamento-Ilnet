# Servido pelo entrypoint do nginx:alpine, que roda envsubst sobre ${API_UPSTREAM}.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Encaminha /api/* para o serviço da API (mantém o prefixo /api).
    location /api/ {
        # O padrão do nginx é 1 MB, e a API aceita corpo de até 24 MB — a guia
        # em PDF e o documento do RH passam disso. O número tem de ser o mesmo
        # do `LIMITE_CORPO` do `main.ts`: sendo menor aqui, o arquivo morre com
        # um 413 cru do nginx, sem nunca chegar em quem sabe dizer o que houve.
        client_max_body_size 24m;
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # O mime.types do nginx não conhece `.webmanifest`, e sem isto o manifesto
    # sai como `application/octet-stream`. Os navegadores até engolem, mas o
    # Chrome reclama no console e o "Instalar app" fica dependendo da boa
    # vontade dele — barato demais para deixar ao acaso.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
    }

    # SPA: qualquer rota cai no index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache de assets com hash
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
