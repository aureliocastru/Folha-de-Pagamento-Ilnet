# Servido pelo entrypoint do nginx:alpine, que roda envsubst sobre ${API_UPSTREAM}.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Compacta o que é texto — o pacote do app, o CSS e o JSON da API. Sem
    # isto (até 13/10/2026) o pacote ia com 1,4 MB pela rede, quando
    # compactado são ~370 KB: no 4G do técnico, a diferença entre abrir na
    # hora e ficar olhando a tela branca. PDF e imagem já vêm compactados de
    # fábrica e ficam de fora. `gzip_proxied any`: a resposta da API passa
    # pelo proxy daqui, e sem ele o nginx não a compactaria.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types
        text/plain
        text/css
        text/csv
        application/javascript
        application/json
        application/manifest+json
        image/svg+xml;

    # Encaminha /api/* para o serviço da API (mantém o prefixo /api).
    location /api/ {
        # O padrão do nginx é 1 MB, e a API aceita corpo de até 24 MB — a guia
        # em PDF e o documento do RH passam disso. O número tem de ser o mesmo
        # do `LIMITE_CORPO` do `main.ts`: sendo menor aqui, o arquivo morre com
        # um 413 cru do nginx, sem nunca chegar em quem sabe dizer o que houve.
        client_max_body_size 24m;
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # O mime.types do nginx não conhece `.webmanifest`, e sem isto o manifesto
    # sai como `application/octet-stream`. Os navegadores até engolem, mas o
    # Chrome reclama no console e o "Instalar app" fica dependendo da boa
    # vontade dele — barato demais para deixar ao acaso.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
    }

    # O index.html é conferido a cada abertura. Sem cabeçalho nenhum, o
    # navegador do celular o guardava por conta própria e seguia abrindo o
    # pacote velho — é ele que diz qual `/assets/index-*.js` é o atual. Os
    # pacotes continuam com cache longo: o nome deles muda a cada versão.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # SPA: qualquer rota cai no index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache de assets com hash
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
